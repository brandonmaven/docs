              {
                "type": "null"
              }
            ],
            "title": "Authnet Transaction Id",
            "description": "Authorize.net Transaction ID"
          },
          "authnet_auth_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authnet Auth Code",
            "description": "Authorize.net Authorization Code"
          },
          "authnet_response_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
