          "card_last4": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Card Last4",
            "description": "Last 4 digits of the card"
          },
          "receipt_url": {
            "anyOf": [
              {
                "type": "string"
